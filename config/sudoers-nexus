# ═══════════════════════════════════════════════════════
# Nexus sudoers — allow backend to control services
# Install (replace NEXUS_USER with the Linux user running Nexus):
#   sed "s/NEXUS_USER/$(whoami)/g" config/sudoers-nexus | sudo tee /etc/sudoers.d/nexus
#   sudo chmod 440 /etc/sudoers.d/nexus && sudo visudo -c
# ═══════════════════════════════════════════════════════

# Allow the nexus process (running as NEXUS_USER) to
# start/stop/restart specific services without password

NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl start cloudflared
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl stop cloudflared
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl restart cloudflared

NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl start jellyfin
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl stop jellyfin
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl restart jellyfin

NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl start filebrowser
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl stop filebrowser
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl restart filebrowser

NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl start cockpit
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl stop cockpit
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl restart cockpit

NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl start wifi
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl stop wifi
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl restart wifi

NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl start postgresql
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl stop postgresql
NEXUS_USER ALL=(ALL) NOPASSWD: /bin/systemctl restart postgresql
