# ─── SERVER ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
# « Diffuser » to DLNA / Roku TVs: address the TV uses to reach Nexus (default: this server's LAN IP and PORT)
# CAST_BASE_URL=http://192.168.1.10:3001

# ─── DATABASE ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus
DB_USER=nexus_user
DB_PASSWORD=your_strong_password_here

# ─── AUTH ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_here_change_in_production
# Optional but recommended: separate secret for refresh tokens
JWT_REFRESH_SECRET=another_different_secret_min_64_chars_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Read-only token appended to media URLs (?token=) for <video>/<img>/<iframe>
JWT_STREAM_EXPIRES_IN=6h

# ─── MEDIA PATHS ──────────────────────────────────────
# Non-admin users can only stream/download files inside MEDIA_ROOT
MEDIA_ROOT=/media
FILMS_PATH=/media/films
SERIES_PATH=/media/series
ANIMES_PATH=/media/animes
MANGA_PATH=/media/scans
YOUTUBE_PATH=/media/youtube

# File manager: optional root it is confined to (default "/": whole server, admin only)
# FILES_ROOT=/media

# Posters / covers are downloaded once and cached here (served by /api/images)
# IMAGE_CACHE_DIR=/opt/nexus/backend/cache/images

# ─── EXTERNAL APIs ────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# AniList — no key needed (GraphQL public API)
ANILIST_API_URL=https://graphql.anilist.co

# MangaDex — no key needed
MANGADEX_API_URL=https://api.mangadex.org

# ─── RATE LIMITING ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
# General API limit per IP per window (media streaming is excluded)
RATE_LIMIT_MAX=1000
# Failed login / refresh attempts per IP per window
AUTH_RATE_LIMIT_MAX=10
# Wrong server (sudo) passwords per IP per window, for forced deletions
SUDO_RATE_LIMIT_MAX=5

# ─── ADMINISTRATOR MODE / TERMINAL ────────────────────
# auto: file actions refused for lack of rights are redone with sudo when the
# Nexus account has passwordless sudo (NOPASSWD); off: never
FILES_SUDO=auto
# A terminal left (page closed, network lost) keeps running this many minutes
TERMINAL_IDLE_MINUTES=60

# ─── AUTOMATIC DEPLOYMENT ─────────────────────────────
# Secret of the GitHub webhook (/api/deploy/webhook), created by
# `sudo bash scripts/auto-deploy.sh install`
DEPLOY_WEBHOOK_SECRET=

# ─── SERVICES PAGE ────────────────────────────────────
# Base domain for service links (https://jellyfin.<domain>…). Empty = no links.
SERVICES_DOMAIN=

# ─── LOGGING ──────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/nexus.log

# ─── DOWNLOADS (Téléchargements) ─────────────────────
# Scripts in downloaders/ (copies of /media/scripts with a --json mode).
# Destination folders are the library folders above (ANIMES_PATH, MANGA_PATH,
# FILMS_PATH, SERIES_PATH, YOUTUBE_PATH). TMDB_API_KEY is passed to the scripts.
# DOWNLOADS_PARALLEL=2            # downloads at the same time
# DOWNLOADS_SEARCH_TIMEOUT_MS=90000
# DOWNLOADERS_DIR=/opt/nexus/downloaders
# PYTHON_BIN=python3

# ─── PUSH NOTIFICATIONS (PWA) ────────────────────────
# Generated automatically in backend/data/vapid.json on first start; set them
# here only to reuse keys (e.g. after reinstalling the server).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ─── IPTV (chaînes publiques iptv-org + Free-TV) ─────
# Python module downloaders/iptv/ (no extra dependency). Catalogue refreshed daily
# by the server, streams checked a few at a time in the background.
# Channels listed as a YouTube / Twitch / Dailymotion live need yt-dlp (installed by
# scripts/deploy.sh for the YouTube downloads); without it they say so.
# IPTV_DISABLED=1                 # no background refresh / checks
# IPTV_API_BASE=https://iptv-org.github.io/api,https://raw.githubusercontent.com/iptv-org/api/gh-pages
# IPTV_PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u
# IPTV_FREETV_URL=https://raw.githubusercontent.com/Free-TV/IPTV/master/playlist.m3u8   # « off » = iptv-org only
# IPTV_YTDLP=/home/nexus/.local/bin/yt-dlp   # a yt-dlp outside the PATH of the service
# IPTV_DATA_DIR=/opt/nexus/downloaders/data/iptv   # HTTP cache of the source files
# IPTV_ALLOW_PRIVATE=1            # relay streams on local addresses too (tests only)
